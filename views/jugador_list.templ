package views

import (
	database "tpweb/db/sqlc"
	"fmt"
)

// JugadorList recibe el slice de jugadores de sqlc. Los equipos se usan para
// mostrar el nombre del equipo en lugar de su id.
templ JugadorList(jugadores []database.Jugadore, equipos []database.Equipo) {
	<section id="jugadores-lista">
		<h2>Jugadores <span class="count">({ len(jugadores) })</span></h2>
		if len(jugadores) == 0 {
			<p class="empty">Todavía no hay jugadores cargados. Agregá el primero con el formulario de arriba.</p>
		} else {
			<div class="tablewrap">
				<table>
					<thead>
						<tr>
							<th scope="col">Foto</th>
							<th scope="col">Nombre</th>
							<th scope="col">Equipo</th>
							<th scope="col">Pos.</th>
							<th scope="col">Nacimiento</th>
							<th scope="col" class="num">Altura</th>
							<th scope="col" class="num">Media</th>
							<th scope="col" class="num">RIT</th>
							<th scope="col" class="num">TIR</th>
							<th scope="col" class="num">PAS</th>
							<th scope="col" class="num">REG</th>
							<th scope="col" class="num">DEF</th>
							<th scope="col" class="num">FIS</th>
							<th scope="col" class="num">Goles</th>
							<th scope="col" class="num">Asist.</th>
							<th scope="col" class="actions-col">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, j := range jugadores {
							<tr id={ fmt.Sprintf("jugador-%d", j.ID) }>
								<td>
									if j.FotoUrl.Valid {
										<img src={ j.FotoUrl.String } alt="" loading="lazy"/>
									} else {
										<span>—</span>
									}
								</td>
								<td>{ j.Nombre }</td>
								<td>{ nombreEquipo(equipos, j.EquipoID) }</td>
								<td>{ j.Posicion }</td>
								<td>{ fecha(j.FechaNacimiento) }</td>
								<td class="num">{ j.Altura }</td>
								<td class="num">{ j.MediaGeneral }</td>
								<td class="num">{ j.Ritmo }</td>
								<td class="num">{ j.Tiro }</td>
								<td class="num">{ j.Pase }</td>
								<td class="num">{ j.Regate }</td>
								<td class="num">{ j.Defensa }</td>
								<td class="num">{ j.Fisico }</td>
								<td class="num">{ j.Goles }</td>
								<td class="num">{ j.Asistencias }</td>
								<td>
										<button
											type="button"
											class="btn"
											hx-get={ fmt.Sprintf("/jugadores/%d/edit", j.ID) }
											hx-target={ fmt.Sprintf("#jugador-%d", j.ID) }
											hx-swap="outerHTML"
										>
											Editar
										</button>
									<button
											type="button"
											class="btn danger"
											hx-delete={ fmt.Sprintf("/jugadores/%d", j.ID) }
											hx-target="closest tr"
											hx-swap="outerHTML"
											hx-confirm="¿Seguro que querés borrar este jugador?"
									>
											Borrar
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
// JugadorEditRow reemplaza la fila del jugador por una fila con inputs.
// Los inputs están en celdas distintas, así que se asocian al <form> de la
// última celda con el atributo form="edit-jugador-{id}".
templ JugadorEditRow(j database.Jugadore, equipos []database.Equipo, f FormState) {
	<tr id={ fmt.Sprintf("jugador-%d", j.ID) }>
		<td>
			<input
				type="url"
				name="foto_url"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("foto_url", j.FotoUrl.String) }
				placeholder="https://..."
			/>
		</td>
		<td>
			<input
				type="text"
				name="nombre"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("nombre", j.Nombre) }
				maxlength="255"
				required
			/>
		</td>
		<td>
			<select name="equipo_id" form={ fmt.Sprintf("edit-jugador-%d", j.ID) } required>
				for _, e := range equipos {
					<option value={ idStr(e.ID) } selected?={ f.GetOr("equipo_id", idStr(j.EquipoID)) == idStr(e.ID) }>{ e.Nombre }</option>
				}
			</select>
		</td>
		<td>
			<select name="posicion" form={ fmt.Sprintf("edit-jugador-%d", j.ID) } required>
				for _, p := range posiciones {
					<option value={ p.Valor } selected?={ f.GetOr("posicion", j.Posicion) == p.Valor }>{ p.Valor }</option>
				}
			</select>
		</td>
		<td>
			<input
				type="date"
				name="fecha_nacimiento"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("fecha_nacimiento", fechaInput(j.FechaNacimiento)) }
				required
			/>
		</td>
		<td>
			<input
				type="number"
				name="altura"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("altura", j.Altura) }
				min="1"
				max="2.5"
				step="0.01"
				required
			/>
		</td>
		for _, s := range statsJugadorEdit(j) {
			<td>
				<input
					type="number"
					name={ s.Valor }
					form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
					value={ f.GetOr(s.Valor, s.Texto) }
					min="1"
					max="99"
					required
				/>
			</td>
		}
		<td>
			<input
				type="number"
				name="goles"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("goles", fmt.Sprint(j.Goles)) }
				min="0"
				required
			/>
		</td>
		<td>
			<input
				type="number"
				name="asistencias"
				form={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				value={ f.GetOr("asistencias", fmt.Sprint(j.Asistencias)) }
				min="0"
				required
			/>
		</td>
		<td>
			<form
				id={ fmt.Sprintf("edit-jugador-%d", j.ID) }
				hx-put={ fmt.Sprintf("/jugadores/%d", j.ID) }
				hx-target="#jugadores-lista"
				hx-swap="outerHTML"
			>
				<button type="submit" class="btn primary">Guardar</button>
				<button
					type="button"
					class="btn"
					hx-get="/jugadores/lista"
					hx-target="#jugadores-lista"
					hx-swap="outerHTML"
				>
					Cancelar
				</button>
			</form>
		</td>
	</tr>
}